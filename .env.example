# ==========================================
# CLIPFORGE AI ENVIRONMENT VARIABLES (.env)
# ==========================================

PORT=8000
HOST=0.0.0.0
DEBUG=False

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
AUTH_PASSWORD=change_me_in_production
AUTH_SECRET=change_this_secret_key_in_production

# ==========================================
# LLM / AI SCORING CONFIGURATION
# ==========================================

# Option 1: Pollinations.ai (OpenAI-Compatible)
LLM_BASE_URL=https://gen.pollinations.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek/deepseek-v4-flash

# Option 2: Local Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3:8b

# Option 3: OpenAI / Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key
# LLM_MODEL=llama-3.1-8b-instant

# ==========================================
# WHISPER TRANSCRIPTION SETTINGS
# ==========================================
# WHISPER_TYPE: "local" (faster-whisper), "groq", "openai", or "auto"
WHISPER_TYPE=local
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# GROQ_API_KEY=your_groq_api_key_for_cloud_whisper

# ==========================================
# VIDEO RENDERING SETTINGS
# ==========================================
VERTICAL_MODE=blur_background
MAX_CLIPS=4
CANDIDATES_COUNT=10
MIN_CLIP_DURATION=30
MAX_CLIP_DURATION=90

DATA_DIR=./data
